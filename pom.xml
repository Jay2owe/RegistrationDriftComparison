	<dependencies>
		<!--
		  ij is the only runtime compile dependency. Everything else below is
		  either build-time only (the two cores, shaded away at package time) or
		  test scope. No ImgLib2, no FFT library, no gnu.trove, no mcib3d, no
		  sc.fiji.*, no net.imagej.updater: one jar, one install, no
		  prerequisites, and the same install story on a bare Fiji as on a
		  developer's machine.

		  Both cores declare net.imagej:ij as `provided`, and `provided` is NOT
		  transitive, so this project has to declare ij itself. It does, first.
		-->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>

		<!--
		  Compiled in, never shipped alongside. Both cores are shaded into this
		  plugin's own jar under regdrift.internal.* by the shade plugin below,
		  so a user installs one file and never learns either core exists.

		  Released versions, not SNAPSHOTs. A shipped jar has to be traceable to
		  source that still exists: a SNAPSHOT keeps resolving out of the local
		  repository long after the source it was built from has moved on, so
		  "which build is in this jar" stops having an answer.

		  Both cores are public on GitHub and neither is published to a Maven
		  repository. If resolution fails, clone
		  https://github.com/Jay2owe/oc3d-core at tag v0.2.0 and
		  https://github.com/Jay2owe/autofix-core at tag v0.1.0 and run
		  `mvn install` in each first.
		-->
		<dependency>
			<groupId>io.github.jay2owe</groupId>
			<artifactId>oc3d-core</artifactId>
			<version>0.2.0</version>
		</dependency>
		<dependency>
			<groupId>io.github.jay2owe</groupId>
			<artifactId>autofix-core</artifactId>
			<version>0.1.0</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  The cores are compiled in, not shipped beside. A user installs one
			  jar and never learns either core exists.

			  Two strings, not one. `artifactSet` names Maven COORDINATES and
			  `relocation` names Java PACKAGES; they differ here
			  (io.github.jay2owe vs sc.fiji.*) and a wrong coordinate does not
			  error - it matches nothing, the build succeeds, and the jar ships
			  without the core classes. That surfaces as NoClassDefFoundError in
			  Fiji, at the moment a user clicks Run.

			  Relocation is mandatory, not tidiness. Fiji has a flat
			  classloader: if two plugins both shipped
			  `sc.fiji.oc3d.core.ui.ToggleSwitch` the first one loaded would win
			  for both, and a version mismatch would produce wrong numbers
			  rather than a crash.

			  `regdrift.RegDrift`, `regdrift.RegDriftParameters` and everything
			  else under `regdrift` is the documented Java and macro API. It is
			  NOT relocated; renaming it would break every script that calls it.

			  Relocation rewrites bytecode references AND any string constant
			  that looks like a relocated package. oc3d-core names five tuning
			  and image properties with literals beginning `sc.fiji.oc3d.core.`
			  and all five are silently rewritten in here. This plugin reads
			  none of them; do not add code that does.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<!--
							  Both cores are shaded in and users install this jar
							  alone. Left on, pom-scijava writes a Class-Path naming
							  ij, oc3d-core and autofix-core jars that do not sit
							  beside this one in Fiji.
							-->
							<addClasspath>false</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!--
							  No <minimizeJar>. CPC sets it and is right to.
							  autofix-core forbids it: its entry points are
							  reached through interfaces this plugin implements
							  (SpecCatalogue, Probe, DependencyKey) and its
							  probes are built from a catalogue the minimiser
							  cannot see through, so minimisation would drop
							  classes only ever reached at runtime. Shade
							  minimises per execution, not per artifact, so one
							  forbidding core settles it for both. The cost is
							  ~60 unreachable oc3d-core classes travelling
							  along: jar size, not correctness.
							-->
							<artifactSet>
								<includes>
									<include>io.github.jay2owe:oc3d-core</include>
									<include>io.github.jay2owe:autofix-core</include>
								</includes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>sc.fiji.oc3d.core</pattern>
									<shadedPattern>regdrift.internal.core</shadedPattern>
								</relocation>
								<relocation>
									<pattern>sc.fiji.autofix.core</pattern>
									<shadedPattern>regdrift.internal.autofix</shadedPattern>
								</relocation>
							</relocations>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/maven/**</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  The validation runs are named for what they are rather than for
			  Surefire's default pattern, so they are named here instead. Without
			  this they compile, pass by hand, and are silently never run by
			  `mvn test` - which is the shape of failure the whole stage exists
			  to avoid.

			  Each of them says by name when it cannot run: the twelve library
			  recordings are not in this repository, the comparison runs need a
			  Fiji with engines in it, and two of them hold two whole recordings
			  at once and need more heap than the SciJava parent's -Xmx512m. On
			  a machine with none of that they skip with the reason printed, and
			  the rest of the suite is unaffected.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/Test*.java</include>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
						<include>**/validation/LibraryValidationRun.java</include>
						<include>**/validation/T4Rerun.java</include>
						<include>**/validation/BenchmarkFixture.java</include>
					</includes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<configuration>
					<licenseResolver>${project.baseUri}src/license</licenseResolver>
					<roots>
						<root>src/main</root>
						<root>src/test</root>
					</roots>
					<includes>
						<include>**/*.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
