# Build output
target/
tools-build/
.mvn/wrapper/maven-dist/

# IDE
.idea/
*.iml
.project
.classpath
.settings/

# Temp files
*.tmp.*

# Build logs written beside the pom rather than into target/. `mvn ... | tee
# target-fullsuite.log` at the repository root is the shape this catches: it
# reads as source, it is the size of a small library, and it is a transcript of
# one run on one machine that VALIDATION.md already records properly.
/*.log
/*.out
/*.txt.bak

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local audit and non-public development material
tools/

# This repository lives inside a synchronized folder. A sync artefact that gets
# committed looks like source and diverges silently.
*conflicted copy*
.conflicted-copies-*/

# Public tree, decided for 0.1.0: the source, the test suite, the build, the
# README, VALIDATION.md and the documents they link (docs/D11, D12, D13,
# docs/figure/, docs/screenshots/). The build plan, internal reviews, harness
# hand-offs and scenario notes stay on disk and out of the public tree, as does
# the RIPR note (RIPR is not part of 0.1.0) and the wiki draft (kept with the
# release plan).
docs/regdrift-build/
docs/release-plan/
docs/release-plan_COMPLETED/
docs/test-scenarios/
docs/REVIEW-*.md
docs/TEST_HANDOFF.md
docs/ripr-registration.md
docs/wiki-page.md
docs/D12_MEASUREMENT_corr.md

# Internal working documents
PUBLISHING_AUDIT.md
